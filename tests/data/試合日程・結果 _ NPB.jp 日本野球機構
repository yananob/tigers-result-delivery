@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Titillium+Web:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500;600;700&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100;300;400;500;700;900&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@200;300;400;500;600;700;900&display=swap");

.schedule_nav { width: 100%; margin: 20px auto 0px; }

.schedule_nav ul { border: 2px solid rgb(70, 121, 200); background: rgb(70, 121, 200); }

.schedule_nav li { box-sizing: border-box; background: rgb(255, 255, 255); height: 30px; line-height: 30px; border-top: 1px solid rgb(40, 98, 174); color: rgb(40, 98, 174); font-weight: bold; font-size: 14px; text-align: center; }

.schedule_nav li:first-child { border-top: none; }

.schedule_nav li a { display: block; color: rgb(40, 98, 174); }

.schedule_nav li a:hover, .schedule_nav li.current a, .schedule_nav li.current { background: rgb(40, 98, 174); color: rgb(255, 255, 255); text-decoration: none; }

section { margin: 20px 0px 30px; }

.page_schedule #layout .team_list_12team .league li img { width: 42px; height: auto; }

.page_schedule #layout .team_list_12team .league:first-child li:first-child { margin-left: 0px; }

.page_schedule #layout .team_list_12team .league:nth-child(2) { margin-left: 42px; }

h5.ttl_month { border: none; background: rgb(40, 98, 174); color: rgb(255, 255, 255); text-align: center; font-size: 14px; padding: 10px; }

#schedule_detail table td { padding: 5px 0px; }

#schedule_detail table tbody td > div, #schedule_detail table tbody td > a, #schedule_detail table tbody td a > div { display: table-cell; padding-right: 5px; vertical-align: middle; }

#schedule_detail table tbody tr { margin-bottom: 0px; }

#schedule_detail table tbody th { padding: 10px 10px 10px 5px; background: rgb(70, 121, 200); color: rgb(255, 255, 255); position: relative; border-bottom: 1px solid rgb(255, 255, 255) !important; }

#schedule_detail table tbody th::after { position: absolute; top: 50%; right: 10px; display: block; content: ""; width: 6px; height: 6px; margin-top: -4px; border-top: 1px solid rgb(255, 255, 255); border-right: 1px solid rgb(255, 255, 255); transform: rotate(45deg); }

#schedule_detail table tbody tr.open th::after { transform: rotate(135deg); }

#schedule_detail table td:nth-of-type(1) { background: rgb(216, 230, 255); text-align: center; padding-left: 5px; }

#exhibition_schedule_detail table td { padding: 5px 0px; }

#exhibition_schedule_detail table tbody td > div, #exhibition_schedule_detail table tbody td > a, #exhibition_schedule_detail table tbody td a > div { display: table-cell; padding-right: 5px; vertical-align: middle; }

#exhibition_schedule_detail table tbody tr { margin-bottom: 0px; }

#exhibition_schedule_detail table tbody th { padding: 10px 10px 10px 5px; background: rgb(70, 121, 200); color: rgb(255, 255, 255); border-bottom: 1px solid rgb(255, 255, 255) !important; }

#exhibition_schedule_detail table tbody th a { color: rgb(255, 255, 255); }

#exhibition_schedule_detail table tbody tr.open th::after { transform: rotate(135deg); }

#exhibition_schedule_detail table tbody tr.open td, #exhibition_schedule_detail table tbody tr td { display: block !important; }

#exhibition_schedule_detail table td:nth-of-type(1) { background: rgb(216, 230, 255); text-align: center; padding-left: 5px; }
