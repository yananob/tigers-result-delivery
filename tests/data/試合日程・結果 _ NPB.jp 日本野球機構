@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Titillium+Web:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500;600;700&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100;300;400;500;700;900&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@200;300;400;500;600;700;900&display=swap");

.table_normal table, .table_center table, .scroll_wrapper table { margin: 20px 0px; width: 100%; }

.table_normal th, .table_center th, .scroll_wrapper th, .table_normal td, .table_center td, .scroll_wrapper td { padding: 5px; border: 1px solid rgb(40, 98, 174); line-height: 1.4; }

.table_normal thead th, .table_center thead th, .scroll_wrapper thead th, .table_normal tfoot th, .table_center tfoot th, .scroll_wrapper tfoot th { background: rgb(70, 121, 200); color: rgb(255, 255, 255); font-weight: normal; }

.table_normal tbody th, .table_center tbody th, .scroll_wrapper tbody th { background: rgb(216, 230, 255); font-weight: normal; }

.sp .table_normal, .sp .table_center, .sp .scroll_wrapper { margin-top: 10px; }

.table_normal_noborder table, .table_noborder_nopadding table { margin: 20px 0px; width: 100%; }

.table_normal_noborder th, .table_noborder_nopadding th, .table_normal_noborder td, .table_noborder_nopadding td { padding: 5px; line-height: 1.4; border: none !important; }

.table_normal_noborder thead th, .table_noborder_nopadding thead th, .table_normal_noborder tfoot th, .table_noborder_nopadding tfoot th { color: rgb(255, 255, 255); font-weight: normal; }

.table_normal_noborder tbody th, .table_noborder_nopadding tbody th { font-weight: normal; }

.sp .table_normal_noborder, .sp .table_noborder_nopadding { margin-top: 10px; }

.hide_sp { display: none !important; }

.clear { clear: both; }

.clearfix { }

.clearfix::after { content: ""; display: table; clear: both; }

.center { text-align: center; }

.left { text-align: left; }

.right { text-align: right; }

.right2 { margin-left: auto; display: table; text-align: left; }

.img-r { float: right; margin-left: 20px !important; margin-bottom: 20px !important; }

.img-l { float: left; margin-right: 20px !important; margin-bottom: 20px !important; }

.img-c { text-align: center; }

.flex_normal_sp { display: flex; flex-direction: row; }

.flex_between_sp { display: flex; flex-direction: row; justify-content: space-between; align-items: center; }

.flex_between_wrap_sp { display: flex; flex-flow: wrap; justify-content: space-between; align-items: center; }

.red, .Red { color: rgb(204, 0, 0); }

.blue, .Blue { color: rgb(40, 98, 174); }

.orange, .Orange { color: rgb(255, 102, 0); }

.green, .Green { color: rgb(46, 139, 87); }

span.xxx { text-decoration: line-through; }

sup { vertical-align: super; font-size: 80%; }

.img_zoom { zoom: 0.5; }

.img_w300 { width: 300px !important; height: auto !important; }

.img_auto { width: 100% !important; height: auto !important; }

.img_w50p { width: 50%; height: auto !important; }

.img_w60p { width: 60%; height: auto !important; }

.img_w70p { width: 70%; height: auto !important; }

.img_w80p { width: 80%; height: auto !important; }

.img_w90p { width: 90%; height: auto !important; }

.video_unit { position: relative; padding-bottom: 56.25%; height: 0px; overflow: hidden; }

.video_unit video, .video_unit iframe, .video_unit object, .video_unit embed { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }

.movie_embeds { position: relative; padding-bottom: 56.25%; height: 0px; overflow: hidden; }

.movie_embeds video, .movie_embeds iframe { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }

a { color: rgb(51, 51, 51); text-decoration: none; }

a:link, a:visited { color: rgb(51, 51, 51); text-decoration: none; }

a:hover { text-decoration: underline; }

a.link_white { color: rgb(255, 255, 255); background: url("https://p.npb.jp/img/common/sp_link_arrow_white.png") 5px center / 4px 5px no-repeat; padding-left: 12px; }

a.link_white:hover { text-decoration: underline; }

a.link_white_underline { color: rgb(255, 255, 255); background: url("https://p.npb.jp/img/common/sp_link_arrow_white.png") 5px center / 4px 5px no-repeat; padding-left: 12px; text-decoration: underline; }

a.link_white_underline:hover { text-decoration: none; }

a.link_black { color: rgb(51, 51, 51); background: url("https://p.npb.jp/img/common/sp_link_arrow_black.png") 5px center / 4px 5px no-repeat; padding-left: 12px; }

a.link_black:hover { text-decoration: underline; }

a.link_black_underline { color: rgb(51, 51, 51); background: url("https://p.npb.jp/img/common/sp_link_arrow_black.png") 5px center / 4px 5px no-repeat; padding-left: 12px; text-decoration: underline; }

a.link_black_underline:hover { text-decoration: none; }

a.link_red { color: rgb(204, 0, 0); background: url("https://p.npb.jp/img/common/sp_link_arrow_red.png") 5px center / 4px 5px no-repeat; padding-left: 12px; }

a.link_red:hover { text-decoration: underline; }

a.link_red_underline { color: rgb(204, 0, 0); background: url("https://p.npb.jp/img/common/sp_link_arrow_red.png") 5px center / 4px 5px no-repeat; padding-left: 12px; text-decoration: underline; }

a.link_red_underline:hover { text-decoration: none; }

a.link_underline { text-decoration: underline; }

a.link_underline:hover { text-decoration: none; }

.link_xxx { color: rgb(170, 170, 170); background: url("https://p.npb.jp/img/common/sp_link_arrow_xxx.png") 5px center / 4px 5px no-repeat; padding-left: 12px; }

.link_list { margin-bottom: 10px; }

.link_list li { margin-bottom: 3px; line-height: 1.3; }

.link_list:last-child { margin-bottom: 0px; }

.link_list_fl li { line-height: 1.6; margin: 0px 0px 0.5em; }

.link_nav { margin-top: 30px; font-size: 0px; }

.link_nav > div { font-size: 12px; }

.link_nav > div:first-child { margin-left: 0px; }

.link_prev, .link_next { display: inline-block; height: 22px; line-height: 22px; }

.link_prev a, .link_next a { display: block; color: rgb(255, 255, 255); }

.link_prev a:hover, .link_next a:hover { opacity: 0.7; text-decoration: none !important; }

.link_prev { background: url("https://p.npb.jp/img/common/bg_link_prev.gif") left center / 22px no-repeat rgb(40, 98, 174); padding: 0px 15px 0px 30px; }

.link_next { background: url("https://p.npb.jp/img/common/bg_link_next.gif") right center / 22px no-repeat rgb(40, 98, 174); padding: 0px 30px 0px 15px; }

.link_nav.center { position: relative; width: 300px; height: 22px; margin: 20px auto; }

.link_nav.center .link_prev, .link_nav.center .link_next { position: absolute; }

.link_nav.center .link_prev { right: 52%; }

.link_nav.center .link_next { left: 52%; }

.link_block { display: block; text-decoration: none; }

.link_block:hover { opacity: 0.7; text-decoration: none !important; }

a.pdf { padding-right: 18px; position: relative; }

a.pdf::after { content: " "; display: inline-block; background: url("https://p.npb.jp/img/common/link_pdf.gif") right center no-repeat; width: 16px; height: 16px; line-height: 1.6; position: absolute; inset: 0px 0px 2px; margin: auto 0px 0px auto; }

p { line-height: 1.6; margin-bottom: 20px; }

h2 { display: block; position: relative; background: rgb(40, 98, 174); padding: 25px 10px; }

h2 #h2_text { display: block; margin: 0px; line-height: 1.2; color: rgb(255, 255, 255); font-size: 18px; font-weight: bold; }

h2 #h2_text a { color: rgb(255, 255, 255); }

h2 #h2_text a:link, h2 #h2_text a:visited { color: rgb(255, 255, 255); }

h2 #h2_text a:hover { text-decoration: none; }

h2 #h2_text small { display: block; line-height: 1.5; font-size: 12px; }

h2 #h2_logo { display: none; }

h2 #h2_score_vs { display: block; position: absolute; margin: auto; top: 0px; right: 0px; bottom: 0px; width: 110px; height: 30px; z-index: 10; }

h2 #h2_score_vs table th { width: 30px; line-height: 1; }

h2 #h2_score_vs table th img { width: 100%; height: auto; }

h2 #h2_score_vs table td { line-height: 1; padding: 0px 7px; text-align: center; font-size: 14px; font-weight: bold; vertical-align: middle; color: rgb(255, 255, 255); }

h2.cate_score { display: block; background: rgb(40, 98, 174); padding: 30px 10px; }

h2.cate_score span { display: block; margin: 0px auto; color: rgb(255, 255, 255); font-size: 18px; font-weight: bold; }

h2.cate_score span .sub_ttl { font-size: 10px; margin-bottom: -10px; }

h2.cate_score a { color: rgb(255, 255, 255); }

h2.cate_score a:link, h2.cate_score a:visited { color: rgb(255, 255, 255); }

h2.cate_score a:hover { text-decoration: none; }

h3 { display: block; background: rgb(109, 109, 109); padding: 15px 10px; }

h3 span { display: block; margin: 0px auto; color: rgb(255, 255, 255); font-size: 16px; font-weight: bold; }

h4 { color: rgb(255, 255, 255); font-size: 16px; padding: 10px; margin-bottom: 20px; background: url("https://p.npb.jp/img/common/bg_h4_main.gif") right bottom / 86px 56px no-repeat rgb(40, 98, 174); }

h4.update { display: table; padding: 0px; width: 100%; height: 36px; line-height: 36px; }

h4.update span { display: table-cell; padding-left: 10px; }

h4.update time { display: table-cell; padding-right: 10px; color: rgb(255, 255, 255); font-size: 10px; font-weight: normal; text-align: right; }

