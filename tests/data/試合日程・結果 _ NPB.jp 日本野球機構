.att_box { padding: 10px; background: rgb(235, 235, 235); line-height: 1.5; }

.att_box ul { margin-top: 5px; }

.date_form_box { padding: 10px; background: rgb(235, 235, 235); }

.date_form_box p { margin-bottom: 8px; }

.players_comment { margin-bottom: 20px; display: flex; }

.players_comment .img { margin: 0px 20px 0px 0px; width: 30%; }

.players_comment .img img { width: 100%; height: auto; }

.players_comment .text { margin: 0px; width: 70%; }

.disc, .circle, .square, .decimal, .kana, .lower-alpha, .lower-roman { margin-top: 0.5em; }

.disc > li, .circle > li, .square > li, .decimal > li, .kana > li, .lower-alpha > li, .lower-roman > li { margin: 0px 0px 0.5em 2em; line-height: 1.6; }

.disc .no_style, .circle .no_style, .square .no_style, .decimal .no_style, .kana .no_style, .lower-alpha .no_style, .lower-roman .no_style { list-style: none; }

.disc > li { list-style: disc; }

.circle > li { list-style: circle; }

.square > li { list-style: square; }

.decimal > li { list-style: decimal; }

.kana > li { list-style: katakana; }

.lower-alpha > li { list-style: lower-alpha; }

.lower-roman > li { list-style: lower-roman; }

.parentheses { margin-top: 0.5em; }

