@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Titillium+Web:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400;500;600;700&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100;300;400;500;700;900&display=swap");

@import url("https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@200;300;400;500;600;700;900&display=swap");

#layout { font-size: 12px; }

#layout header #header_score { height: 50px; overflow: hidden; }

#layout header #header_score .score_wrap { width: 1090px; height: 50px; margin: 0px auto; overflow: hidden; }

#layout header #header_score .score_wrap .score_box { display: table-cell; width: 85px; height: 50px; border-right: 1px solid rgb(233, 233, 233); }

#layout header #header_score .score_wrap .score_box a { display: block; }

#layout header #header_score .score_wrap .score_box a > div { position: relative; display: table-cell; width: 85px; height: 50px; }

#layout header #header_score .score_wrap .score_box a .logo_left, #layout header #header_score .score_wrap .score_box a .logo_right { position: absolute; top: 5px; height: 18px; width: 18px; }

#layout header #header_score .score_wrap .score_box a .logo_left { left: 3px; }

#layout header #header_score .score_wrap .score_box a .logo_right { right: 3px; }

#layout header #header_score .score_wrap .score_box a .score { position: absolute; top: 7px; font-family: "Titillium Web", sans-serif; font-weight: bold; text-align: center; font-size: 14px; width: 85px; }

#layout header #header_score .score_wrap .score_box a .state { font-size: 7px; text-align: center; margin-top: 26px; }

#layout header #header_score .score_wrap .date { width: 70px; font-family: "Titillium Web", sans-serif; font-size: 12px; font-weight: bold; vertical-align: middle; text-align: center; background: rgb(233, 233, 233); border: none; }

#layout header #header_score .detail { width: 30px; position: absolute; top: 0px; right: 0px; }

#layout header #header_score .detail a { display: table-cell; vertical-align: middle; width: 40px; height: 50px; font-family: "Titillium Web", sans-serif; font-size: 14px; font-weight: bold; text-align: center; background: rgb(233, 233, 233); }

#layout header #header_nav { height: 60px; background: rgb(0, 0, 0); }

#layout header #header_nav .wrap { width: 100%; height: 60px; margin: 0px auto; position: relative; }

#layout header #header_nav .wrap h1 { position: absolute; top: 10px; left: 10px; display: block; background: url("https://p.npb.jp/img/common/logo/logo_npb_header.gif") 0% 0% / 48px 41px no-repeat rgb(0, 0, 0); width: 48px; height: 41px; }

#layout header #header_nav .wrap h1 a { display: block; width: 48px; height: 41px; text-indent: -99999em; overflow: hidden; }

#layout header #header_nav .wrap .social { position: absolute; top: 0px; right: 0px; }

#layout header #header_nav .wrap .social ul { display: flex; align-items: center; }

#layout header #header_nav .wrap .social li { display: block; margin-left: 12px; }

#layout header #header_nav .wrap .social li a { color: rgb(255, 255, 255); display: block; height: 25px; line-height: 25px; font-size: 12px; }

#layout header #header_nav .wrap .social li.tw, #layout header #header_nav .wrap .social li.fb, #layout header #header_nav .wrap .social li.yt { text-indent: -999999em; width: 25px; height: 25px; }

