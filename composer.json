{
    "name": "yananob/tigers-result-delivery",
    "description": "yananob/tigers-result-delivery",
    "license": "proprietary",
    "require": {
        "php": ">= 8.2",
        "google/cloud-functions-framework": "^1.4",
        "google/cloud-firestore": "^1.55",
        "guzzlehttp/guzzle": "^7.10",
        "nesbot/carbon": "^3.8",
        "paquettg/php-html-parser": "^2.2",
        "openai-php/client": "^0.19.2",
        "http-interop/http-factory-guzzle": "^1.2",
        "monolog/monolog": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "./tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
